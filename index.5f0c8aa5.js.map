// #region add a form to the document
var form = document.createElement("form");
var button = document.createElement("button");
form.noValidate = true;
form.classList.add("new-employee-form");
button.innerText = "Save to table";
button.type = "submit";
fields.forEach(function(field) {
    var label = document.createElement("label");
    var input = document.createElement("input");
    var select = document.createElement("select");
    var newField = input;
    if (field === "office") {
        newField = select;
        offices.forEach(function(office) {
            var option = document.createElement("option");
            option.value = office;
            option.innerText = office.charAt(0).toUpperCase() + office.slice(1);
            newField.append(option);
        });
    }
    newField.name = field;
    if (newField.name === "age" || newField.name === "salary") newField.type = "number";
    else if (newField.name !== "office") newField.type = "text";
    newField.setAttribute("data-qa", field);
    newField.required = true;
