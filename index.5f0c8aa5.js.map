// #endregion add a form to the document
// #region notifications
var pushNotifications = function(title, description, type) {
    var div = document.createElement("div");
    var h2 = document.createElement("h2");
    var p = document.createElement("p");
    div.classList.add("notification");
    div.classList.add("".concat(type));
    div.setAttribute("data-qa", "notification");
    h2.classList.add("title");
    h2.innerText = title;
    p.innerText = description;
    div.append(h2, p);
    body.append(div);
    setTimeout(function() {
        div.style.visibility = "hidden";
    }, 2000);
};
// #endregion notifications
// #region create new employee
var createNewEmployee = function(data) {
    var entries = Object.fromEntries(data);
    var tr = document.createElement("tr");
    for(var el in entries){
        var td = document.createElement("td");
        var formattedSalary = null;
        if (el === "salary") formattedSalary = "$" + Number(entries[el]).toLocaleString("en-US");
        td.innerText = formattedSalary || entries[el];
        tr.appendChild(td);
    }
    tableBody.append(tr);
};
