// #region editing of table cells by double-clicking on them
tableBody.addEventListener("dblclick", function(e) {
    var chosenCell = e.target.closest("td");
    var input = document.createElement("input");
    if (!chosenCell) return;
    if (chosenCell.querySelector("input")) return;
    var originaltext = chosenCell.textContent;
    input.type = "text";
    input.classList.add("cell-input");
    input.value = chosenCell.textContent;
    chosenCell.textContent = "";
    chosenCell.appendChild(input);
    input.focus();
    input.addEventListener("blur", function() {
        if (!input.value) {
            chosenCell.textContent = originaltext;
            input.remove();
            return;
        }
        chosenCell.textContent = input.value;
        input.remove();
    });
    input.addEventListener("keydown", function(press) {
        if (press.key === "Enter") {
            if (!input.value) {
                chosenCell.textContent = originaltext;
                input.remove();
                return;
            }
            chosenCell.textContent = input.value;
            input.remove();
        }
        if (press.key === "Escape") {
            chosenCell.textContent = originaltext;
            input.remove();
        }
    });
}); // #endregion editing of table cells by double-clicking on them

